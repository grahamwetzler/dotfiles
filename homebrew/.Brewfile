tap "abue-ammar/tinycast", trusted: true
tap "kenn-io/tap"
tap "xcodesorg/made", trusted: { formulae: ["xcodes"] }
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Container runtimes on MacOS (and Linux) with minimal setup
brew "colima"
# Pack, ship and run any application as a lightweight container
brew "docker"
# GitHub command-line tool
brew "gh"
# Open source programming language to build simple/reliable/efficient software
brew "go"
# Agent multiplexer that lives in your terminal
brew "herdr"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Open-source, cross-platform JavaScript runtime environment
brew "node"
# Prompt theme engine for any shell
brew "oh-my-posh"
# Organize software neatly under a single directory tree (e.g. /usr/local)
brew "stow"
# Automatic code review daemon for git commits using AI agents
brew "kenn-io/tap/roborev", trusted: true
# Terminal-based AI coding assistant
cask "claude-code"
# OpenAI's coding agent that runs in your terminal
cask "codex"
cask "font-jetbrains-maple-mono-nf"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Tiny, fully native launcher, hotkeys, and clipboard history
cask "abue-ammar/tinycast/tinycast"
npm "ccstatusline"
